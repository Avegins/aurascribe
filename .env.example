# ==============================================================================
# AuraScribe Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Configure your secrets and endpoints below.
# 3. For security, .env is git-ignored and should NEVER be checked into source control.
# ==============================================================================

# Application Environment (development, testing, production)
AURASCRIBE_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=5000

# ------------------------------------------------------------------------------
# LLM Provider & Inference Configuration
# ------------------------------------------------------------------------------
# Backend options:
# - 'llama_cpp': High-performance llama.cpp server (local or remote philgood)
# - 'ollama': Local or remote Ollama runner
# - 'custom': Any OpenAI-compatible cloud/local provider (Groq, OpenRouter, vLLM)
# - 'openai': Official OpenAI API (GPT-4o, etc.)
AURASCRIBE_LLM_PROVIDER=llama_cpp

# Target model identifier:
# - For llama.cpp: qwen2.5-7b-instruct, gemma-2-9b-it, etc.
# - For Ollama: qwen3.5:9b-q8_0, gemma4:12b-it-q4_K_M
# - For OpenAI: gpt-4o-mini, gpt-4o
AURASCRIBE_LLM_MODEL=qwen2.5-7b-instruct

# --- Option A: llama.cpp Server ---
# Use http://localhost:8080/v1 for local, or http://philgood:8080/v1 for remote host
LLAMA_CPP_BASE_URL=http://localhost:8080/v1

# --- Option B: Ollama Runner ---
# Use http://localhost:11434/v1 for local/SSH tunnel, or http://philgood:11434/v1 for remote host
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# --- Option C: Custom / Cloud Provider (Groq, OpenRouter, Alibaba DashScope, vLLM) ---
# Used when AURASCRIBE_LLM_PROVIDER=custom
AURASCRIBE_CUSTOM_BASE_URL=
AURASCRIBE_CUSTOM_API_KEY=

# --- Option C: OpenAI Cloud ---
# OpenAI API Key (required ONLY if AURASCRIBE_LLM_PROVIDER=openai or using OpenAI Whisper)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Speech Transcription Configuration
# ------------------------------------------------------------------------------
# Provider: 'openai' (cloud) or 'custom' (self-hosted Whisper, faster-whisper, vLLM)
AURASCRIBE_TRANSCRIPTION_PROVIDER=openai

# Model identifier for audio transcription
AURASCRIBE_TRANSCRIPTION_MODEL=whisper-1

# Optional custom base URL for self-hosted or local Whisper server (e.g. http://philgood:8000/v1)
AURASCRIBE_TRANSCRIPTION_BASE_URL=

# Optional default speech audio language hint ('tl', 'en', 'es', 'ceb', 'ja', etc.)
# Leave empty for automatic language detection across all languages
AURASCRIBE_DEFAULT_LANGUAGE_HINT=

# ------------------------------------------------------------------------------
# Multilingual Clinical Translation Settings
# ------------------------------------------------------------------------------
# Standard target documentation language for SOAP synthesis
# Options: 'English' (standard clinical medical English), 'Spanish', 'Tagalog', 'Auto'
AURASCRIBE_TARGET_LANGUAGE=English

# ------------------------------------------------------------------------------
# Security, Limits & Operational Constraints
# ------------------------------------------------------------------------------
# Max audio upload size in bytes (26214400 bytes = 25 MB)
AURASCRIBE_MAX_AUDIO_SIZE_BYTES=26214400

# Request Timeout in seconds for external inferences
AURASCRIBE_REQUEST_TIMEOUT_SECONDS=60

# Maximum retries for agent schema validation recovery
AURASCRIBE_AGENT_RETRY_LIMIT=2

# Structured Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
AURASCRIBE_LOG_LEVEL=INFO

# Clinical Extraction Prompt Version
AURASCRIBE_PROMPT_VERSION=1.1.0

