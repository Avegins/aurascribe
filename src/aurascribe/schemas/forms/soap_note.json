{
  "form_id": "soap_note",
  "form_title": "Structured SOAP Note",
  "form_description": "Standard Clinical SOAP Documentation Template",
  "sections": [
    {
      "id": "subjective",
      "title": "Subjective (S)",
      "subtitle": "Patient Reported History",
      "badge": "S",
      "color_theme": "indigo",
      "fields": [
        {
          "key": "subjective.chief_complaint",
          "label": "Chief Complaint (CC) *",
          "type": "text",
          "placeholder": "Primary symptom or reason for visit...",
          "required": true
        },
        {
          "key": "subjective.history_of_present_illness",
          "label": "History of Present Illness (HPI)",
          "type": "textarea",
          "rows": 3,
          "placeholder": "Onset, duration, severity, characteristics, aggravating/alleviating factors..."
        },
        {
          "key": "subjective.current_medications",
          "label": "Current Medications",
          "type": "text",
          "placeholder": "Active medications or 'None reported'",
          "grid_column": "span 1"
        },
        {
          "key": "subjective.allergies",
          "label": "Allergies",
          "type": "text",
          "placeholder": "Known drug/food allergies or 'NKDA'",
          "grid_column": "span 1"
        }
      ]
    },
    {
      "id": "objective",
      "title": "Objective (O)",
      "subtitle": "Clinical Observations & Vitals",
      "badge": "O",
      "color_theme": "teal",
      "fields": [
        {
          "key": "objective.vital_signs",
          "label": "Vital Signs",
          "type": "text",
          "placeholder": "BP: 120/80 mmHg, HR: 74 bpm, Temp: 36.6 °C, SpO2: 98%..."
        },
        {
          "key": "objective.physical_exam",
          "label": "Physical Examination Findings",
          "type": "textarea",
          "rows": 2,
          "placeholder": "Inspection, palpation, auscultation, clinical findings..."
        }
      ]
    },
    {
      "id": "assessment",
      "title": "Assessment (A)",
      "subtitle": "Diagnosis & Clinical Impression",
      "badge": "A",
      "color_theme": "blue",
      "fields": [
        {
          "key": "assessment.primary_diagnosis",
          "label": "Primary Diagnosis",
          "type": "text",
          "placeholder": "Working clinical diagnosis or clinical impression...",
          "required": true
        },
        {
          "key": "assessment.differential_diagnoses",
          "label": "Differential Diagnoses",
          "type": "text",
          "placeholder": "Alternative diagnoses or clinical uncertainties..."
        }
      ]
    },
    {
      "id": "plan",
      "title": "Plan (P)",
      "subtitle": "Treatment, Rx & Follow-Up",
      "badge": "P",
      "color_theme": "purple",
      "fields": [
        {
          "key": "plan.prescriptions",
          "label": "Prescriptions & Pharmacotherapy",
          "type": "textarea",
          "rows": 2,
          "placeholder": "Prescribed drugs, dosages, route, frequency, duration..."
        },
        {
          "key": "plan.instructions",
          "label": "Instructions & Follow-Up",
          "type": "textarea",
          "rows": 2,
          "placeholder": "Patient advice, follow-up schedule, return precautions, diagnostics ordered..."
        }
      ]
    }
  ]
}

